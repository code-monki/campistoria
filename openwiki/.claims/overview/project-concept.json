  "claims": [
    {
      "id": "claim_da377abf5b5349e1b641cbe98b2e9053",
      "statement": "Campistoria is a system-neutral engine for maintaining persistent tabletop RPG campaign state, supporting solo play, GM-led campaigns, and other play styles without embedding assumptions of a particular RPG system, setting, genre, or UI.",
      "evidence": [
        {
          "resource": "repo://README.md#L3-L9",
          "version": "repo-lines-v1:sha256:c870a5e36c78831ed92469460a0e15352cdc1550ad045df21b4e3a69c3969fe6:"
        }
      ]
    },
    {
      "id": "claim_b60b39a7e7b5433ea9bd06dae4e3e5ad",
      "statement": "Existing solo-RPG tools are often disconnected, typically failing to maintain authoritative campaign reality, observer knowledge, unresolved state, provenance, temporal state, package composition, and durable history as one coherent runtime; Campistoria exists to preserve continuity while leaving game-system meaning to packages and creative authority with the human player.",
      "evidence": [
        {
          "resource": "repo://docs/agent/engine-primer.md#L37-L39",
          "version": "repo-lines-v1:sha256:55f9d8958a5ea6363a09fde5a33ba4a02fbcb594ad0a7edd4a5266444071b26c:"
        }
      ]
    },
    {
      "id": "claim_c767cca78c8e4f80b3c377bc8d8bc7f7",
      "statement": "Campaign Reality and Observer Knowledge are separate: Resolution changes Campaign Reality while Observation changes Observer Knowledge, and discovering something changes observer knowledge without necessarily creating the thing being discovered.",
      "evidence": [
        {
          "resource": "repo://README.md#L31-L35",
          "version": "repo-lines-v1:sha256:ed78ada2abfdae9b2bfe09c7aac46064cfe43f5510dd7c37f10eca2df34f894a:"
        },
        {
          "resource": "repo://docs/agent/engine-primer.md#L61-L63",
          "version": "repo-lines-v1:sha256:a43ec05564ef628c3dfd9208628579022cfb3f0d2d82f58211579f62a993fc0c:"
        }
      ]
    },
    {
      "id": "claim_47e6634ae28a4c9fb2d8b1f4744a6fef",
      "statement": "The engine owns generic campaign-runtime machinery and must not hard-code specific RPG system/edition/genre/setting concepts (e.g. Traveller, D&D, hexcrawls, armor class); packages define game- and world-specific semantics and should prefer data/schemas/declarative rules over arbitrary executable code.",
      "evidence": [
        {
          "resource": "repo://docs/agent/engine-primer.md#L116-L154",
          "version": "repo-lines-v1:sha256:2fe5a8b0e6fc5b26a45420fd1da2d81610ec6b31f6685a4d32a5c578f5d94c55:"
        }
      ]
    },
    {
      "id": "claim_43c4ab4389fe453d8db6f34c6e806f3b",
      "statement": "A running campaign pins the exact package composition it was instantiated from; installing a newer package version does not silently alter an existing campaign, package upgrades are explicit migrations, and package versions coexist rather than the newest silently winning.",
      "evidence": [
        {
          "resource": "repo://README.md#L97-L99",
          "version": "repo-lines-v1:sha256:08571ff93864722c000bb8831d44c3a82ada310502a2a28dae656e8eaa9879d9:"
        },
        {
          "resource": "repo://docs/agent/engine-primer.md#L206-L211",
          "version": "repo-lines-v1:sha256:2c0b715e129a616504a330e5040c933dc531913d68bc09a8d65ec1488bc406ae:"
        }
      ]
    },
    {
      "id": "claim_83fd79ecfcbc486c84894a53c4925aca",
      "statement": "Scenario content is immutable authored starting definition; starting play instantiates a mutable Campaign, the same Scenario may produce many divergent Campaigns, and running play mutates the Campaign, never the Scenario.",
      "evidence": [
        {
          "resource": "repo://docs/agent/engine-primer.md#L215-L219",
          "version": "repo-lines-v1:sha256:8fa5d6447e02a36525dd5bae5c23e91c3f5b06be450a1df9c0d34d8c2a64f79c:"
        }
      ]
    },
    {
      "id": "claim_573e678016854c8f9f8a0846a34aad13",
      "statement": "Every Campaign-scoped operation requires an active local Campaign Authority Binding between the requesting Principal and target Campaign; session, role, or capability claims supplied by a caller do not self-authorize, and this minimal single-player authorization boundary does not introduce hosted identity, accounts, invitations, or multiplayer authority administration.",
      "evidence": [
        {
          "resource": "repo://docs/agent/engine-primer.md#L260-L262",
          "version": "repo-lines-v1:sha256:faf0156ddae140e18622a73e6a5c0dc89819ff15baf2c6de45004b368b53ac9d:"
        }
      ]
    },
    {
      "id": "claim_08783153da3c46219915084b52e494b5",
      "statement": "Campistoria is explicitly not a Virtual Tabletop; a VTT-like application may be a client of the engine, but token manipulation UX, live table presence, chat, and audio/video belong outside the engine unless explicitly reopened through lifecycle change control.",
      "evidence": [
        {
          "resource": "repo://docs/agent/engine-primer.md#L164-L166",
          "version": "repo-lines-v1:sha256:150b609c5fea31652685e3ddf7329a3bd0adf7c18124f5619b80d9440878fca1:"
        }
      ]
    }
