    {
      "id": "claim_d93493d97b8447068e477b35f7c0161e",
      "statement": "The HLA adopts Hexagonal Architecture (Ports and Adapters) as the overall style because FR-039 requires symmetric access for first-party and third-party callers; Layered Architecture was rejected for implying a single primary caller on top, and Event-Driven Architecture was rejected at the system level because the dominant interaction shape is synchronous request/response, not async pub/sub.",
      "evidence": [
        {
          "resource": "repo://docs/architecture/engine-hla.md#L138-L146",
          "version": "repo-lines-v1:sha256:9bea4df29cd368313f7dd425ee60f59041f571de542ad8d65a981692775c391a:"
        }
      ]
    },
    {
      "id": "claim_e14ca7bcdb9a4c17b69118556ab33774",
      "statement": "Microkernel was considered for the whole engine but scoped specifically to HLA-PACKAGE instead, since most other components are fixed engine responsibilities rather than plugin-shaped.",
      "evidence": [
        {
          "resource": "repo://docs/architecture/engine-hla.md#L146-L146",
          "version": "repo-lines-v1:sha256:8418593ca81f20dd502be579f195e383b199b75b2607929d61aae1b784432f1f:"
        }
      ]
    },
    {
      "id": "claim_3286c06cd75945a9a5f8d9298c6b498b",
      "statement": "HLA-CORE sits at the center of the hexagon with no outward dependencies; ports point inward and adapters depend on ports, never the reverse.",
      "evidence": [
        {
          "resource": "repo://docs/architecture/engine-hla.md#L148-L148",
          "version": "repo-lines-v1:sha256:20ac3a4dcd81ed9b70bf9216e02fbe00392d0a51d7a7a3f109a45f7cfed6a1ca:"
        }
      ]
    },
    {
      "id": "claim_1ca65d671b5647c9a63e8a464c026389",
      "statement": "Every component traces to at least one Requirement ID and every FR group in the SRS maps to at least one HLA component, with no orphan requirements or untraceable structural elements.",
      "evidence": [
        {
          "resource": "repo://docs/architecture/engine-hla.md#L273-L273",
