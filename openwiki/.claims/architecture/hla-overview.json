    {
      "id": "claim_49ba7f0e9c154daf845ce84dbc355921",
      "statement": "The persistence model is an append-only Event log per Campaign and per Observer with periodic Memento-pattern snapshots bounding replay cost; Campaign Authority Bindings are owned/evaluated by HLA-CONTRACT with durable representation delegated to HLA-PERSIST, and Presentation Models are never persisted as authoritative data.",
      "evidence": [
