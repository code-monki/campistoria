    {
      "id": "claim_53ff3cddda2344bea48583fe4bf515b4",
      "statement": "The only probabilistic component is a package-defined Oracle; it is isolated behind a single engine-owned generic Oracle Adapter inside HLA-RESOLUTION with no authority to write Campaign Reality, and containment logic ensures only a Resolution Command may ever write to Campaign Reality.",
      "evidence": [
        {
          "resource": "repo://docs/architecture/engine-hla.md#L115-L123",
          "version": "repo-lines-v1:sha256:30350cd3a80ca159d08424ff599223c40c05b018770263b7e7d88a94088d9441:"
        }
      ]
    },
    {
      "id": "claim_adf53e0a09464191a8b42a39b4500a8f",
      "statement": "If the Oracle Adapter cannot produce a valid result, the associated element remains Unresolved with no default or synthesized value substituted; every Resolution Command records its source as part of the appended Event.",
      "evidence": [
        {
          "resource": "repo://docs/architecture/engine-hla.md#L125-L127",
