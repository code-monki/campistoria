    {
      "id": "claim_0212195a6db64569933adb7393640a00",
      "statement": "HLA-QUERY combines Facade (concentrating POV filtering authority so no Projection independently reimplements it) with Strategy (Map/Timeline/Roster/Journal/RelationshipView projections as interchangeable algorithms); Visitor was rejected because Package-extensible entity/relationship types are an open type set, and Template Method was rejected because projection types don't share enough algorithmic skeleton.",
      "evidence": [
        {
          "resource": "repo://docs/architecture/engine-hla.md#L220-L222",
          "version": "repo-lines-v1:sha256:ffe49a40eded79ea151e9b07b1c6ce1e34a18f4a8420d2ac599fb2bfa6584e24:"
        }
      ]
    },
    {
      "id": "claim_11ff058f68dd43a88c72164e5591be89",
      "statement": "HLA-QUERY is architecturally decomposed into eleven internal modules (QueryFacade, QueryContextNormalizer, AuthoritativeReadCoordinator, POVResolver, ProjectionStrategyRegistry, PresentationMaterializer, PresentationRevisionTracker, DeltaMaterializer, ArchiveBridge, ToolingInspectionViewBuilder, QueryDiagnosticsBuilder), mandatory as a design rule so responsibilities stay separately testable.",
      "evidence": [
        {
          "resource": "repo://docs/design/components/hla-query-dd.md#L151-L167",
          "version": "repo-lines-v1:sha256:ea27c305b26dbff9d25e1c3c35c9397eb233e5fa38b5b94930060284447752c6:"
        }
      ]
    },
    {
      "id": "claim_b9cf9566a4834b2184b366067b57622e",
      "statement": "HLA-QUERY preserves a strict distinction between Truth (HLA-CORE), Knowledge (HLA-OBSERVER), and Presentation (HLA-QUERY's own decision); it may present false/stale/incomplete Observer Knowledge without correcting it to match Campaign Reality, and never exposes raw Campaign Reality as a shortcut around POV Resolution.",
      "evidence": [
        {
          "resource": "repo://docs/design/components/hla-query-dd.md#L255-L263",
          "version": "repo-lines-v1:sha256:36d9c20fc1902569b1f2a555f571e53a8b9316422a3daf91a6b1998ec8e11a14:"
        }
      ]
