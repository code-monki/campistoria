        }
      ]
    },
    {
      "id": "claim_b719e0b0db9348a7b19da3cd892bc7f5",
      "statement": "HLA-RESOLUTION is internally decomposed into seven modules (UnresolvedStateRegistry, ResolutionCommandFactory, ResolutionSourceNormalizer, OracleAdapter, OracleResultAcceptor, ResolutionApplier, UndoDescriptorBuilder) each with defined persistent authority.",
      "evidence": [
        {
          "resource": "repo://docs/design/components/hla-resolution-dd.md#L149-L155",
          "version": "repo-lines-v1:sha256:5ab4944c16e0b3e242e07be4caada29b61cb1b3614538e80a5c86bd586412519:"
        }
      ]
