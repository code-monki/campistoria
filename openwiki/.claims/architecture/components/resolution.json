      "evidence": [
        {
          "resource": "repo://docs/design/components/hla-resolution-dd.md#L92-L100",
          "version": "repo-lines-v1:sha256:719ca305cf93d0521c495f0da7832e521049fb5e1f5b57ec31f6c9eeb30a0afd:"
