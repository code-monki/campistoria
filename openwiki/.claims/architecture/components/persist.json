  "claims": [
    {
      "id": "claim_20d5e13cab2744668738c080c588e9fb",
      "statement": "HLA-PERSIST applies the Adapter pattern layered over the Event Sourcing store in HLA-CORE/HLA-OBSERVER rather than a separate persistence-specific data model, because a second representation purely for persistence would reintroduce the drift risk Event Sourcing was chosen to avoid.",
      "evidence": [
        {
          "resource": "repo://docs/architecture/engine-hla.md#L231-L233",
          "version": "repo-lines-v1:sha256:6dc1d1b9639ac46f13c32fc4342d82c8b0a66aafc4ba609f4fa84922a19c1831:"
        }
      ]
    },
    {
      "id": "claim_3efc057f2da44d06b1488fc40a44e89c",
      "statement": "HLA-PERSIST is internally decomposed into nine modules (PersistenceCoordinator, EventStreamStoreAdapter, SnapshotStoreAdapter, AuthorityBindingStoreAdapter, ExportAssembler, ImportReader, AssetPortabilityManager, ArchiveIndex, ArchiveRetriever) each with a defined persistent authority.",
      "evidence": [
        {
          "resource": "repo://docs/design/components/hla-persist-dd.md#L150-L158",
          "version": "repo-lines-v1:sha256:524fd6556685696a3037b41e0359dcde122dcf6c6ec15c6811e352e14d45595e:"
        }
      ]
    },
    {
      "id": "claim_1d305a141bf74df086a9379c77ba72bf",
      "statement": "HLA-PERSIST never becomes authoritative for the data classes it stores; the authoritative owner remains HLA-CORE, HLA-OBSERVER, HLA-PACKAGE, HLA-CONTRACT, or HLA-STATE respectively, and Presentation Models are never persisted as authoritative state at all.",
      "evidence": [
        {
          "resource": "repo://docs/design/components/hla-persist-dd.md#L197-L206",
          "version": "repo-lines-v1:sha256:2fe9fff68b3de25f4796199dcb6542930059fedc6b5f4a13d3a6a436245cc646:"
        }
      ]
    },
    {
      "id": "claim_cecc5ab8336840c7b97ff9f5e41b1b50",
      "statement": "Campaign import treats artifacts as untrusted input: HLA-VALIDATE must return a strict accept before admission, acceptWithWarnings/reject/indeterminate never admit import data, partial import is prohibited, and a foreign Principal or capability grant in an export never becomes active local authority without HLA-CONTRACT's explicit rebinding step.",
      "evidence": [
        {
          "resource": "repo://docs/design/components/hla-persist-dd.md#L317-L328",
          "version": "repo-lines-v1:sha256:d0e64dc56755726901a08e65696cd3b497749491f3335f56b744ffe002a76209:"
        }
      ]
    },
    {
      "id": "claim_6670a1b7b3d84901b79f1419f5939536",
      "statement": "Decision DEC-001 underlies the import rebinding rule: exported source-binding identifiers are retained only as non-authoritative provenance, and HLA-PERSIST never decides whether an import request is authorized.",
      "evidence": [
        {
          "resource": "repo://docs/design/components/hla-persist-dd.md#L323-L324",
          "version": "repo-lines-v1:sha256:949a113021651651d330ea0c7aa6cb7d28be6d35eca04ef3ee4bf4a422c0044e:"
        },
        {
          "resource": "repo://docs/project/decision-log.md#L13-L21",
          "version": "repo-lines-v1:sha256:a26221c345bace1dbf769c58e1c41edd136bee6d8e6175dd6883932c49665df2:"
        }
      ]
    },
    {
      "id": "claim_806f9a163d7e41d48947ff9a745cb18e",
      "statement": "Campaign export fails if any campaignLocal asset referenced by Campaign Reality or Observer Knowledge cannot be included or otherwise guaranteed portable; a degraded export is not a valid Campaign export under FR-032/FR-042 even if a diagnostic packaging audit is produced.",
      "evidence": [
        {
          "resource": "repo://docs/design/components/hla-persist-dd.md#L256-L256",
          "version": "repo-lines-v1:sha256:c0c8c230ce577de7285fd75a2e82d46ef702544f3d76cba50eaaa98ddc597f5a:"
        }
      ]
    },
    {
      "id": "claim_06910624819c4021a6913609003e632d",
      "statement": "Package-sourced assets are not duplicated into every Campaign export when the Package is independently exportable, but composition pins alone are not treated as proof of asset availability; HLA-PERSIST verifies portability during export and fails with diagnostics if verification fails.",
      "evidence": [
