    {
      "id": "claim_ddfd29ba84f643e7a194ccc48d973ea5",
      "statement": "HLA-VALIDATE treats externally supplied artifacts (Packages, Campaign imports, Oracle results, including LLM-generated or LLM-modified artifacts) as untrusted and potentially hostile, not merely malformed, and AI-generated artifacts receive no special trust.",
      "evidence": [
        {
          "resource": "repo://docs/design/components/hla-validate-dd.md#L66-L66",
          "version": "repo-lines-v1:sha256:6118d7846cb23e2cb766c6996d524846f101725550ad3aac5088a2f34dd16c52:"
        }
      ]
    },
    {
      "id": "claim_faf677736a8b4f7f8a006ee10f93febe",
      "statement": "HLA-VALIDATE uses Chain of Responsibility because validation rules are contributed by multiple sources and must compose without a fixed closed algorithm; Template Method was rejected because it would need rewriting for every new check, and Visitor was rejected for the same open-type-hierarchy reason as HLA-QUERY.",
      "evidence": [
        {
          "resource": "repo://docs/architecture/engine-hla.md#L254-L256",
          "version": "repo-lines-v1:sha256:1804a08d03544407cb51dad345f8ce0186f568985fe4e34ac613d00ec00a9af3:"
        }
      ]
    },
    {
      "id": "claim_00f6043641994be3b0235d21578e481b",
      "statement": "HLA-VALIDATE recognizes six validation subject types (packageArtifact, effectiveCampaignDefinition, campaignImportArtifact, oracleResult, migrationPlan, exportArtifact), each with an owning caller and required validation layers; the taxonomy is deliberately limited to subjects visible in the approved HLA/SRS.",
      "evidence": [
        {
          "resource": "repo://docs/design/components/hla-validate-dd.md#L147-L158",
          "version": "repo-lines-v1:sha256:26bf6a887e664ad208fd0449c3f55407c299792f65bfc0bd83022a41fedbded7:"
