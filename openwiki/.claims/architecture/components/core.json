  "claims": [
    {
      "id": "claim_254b28f0dfdf40f7888975d1591c3668",
      "statement": "HLA-CORE has no outward dependencies on any other HLA component; it is the center of the hexagonal architecture, and other components access Campaign Reality only through HLA-CORE.",
      "evidence": [
        {
          "resource": "repo://docs/architecture/engine-hla.md#L179-L181",
          "version": "repo-lines-v1:sha256:b491e029cd5786b563d021d673cbcfdc8f3e369648d8cbe42560212de74be3d2:"
        }
      ]
    },
    {
      "id": "claim_b82f74da866f4de5a6f51a357ffee946",
      "statement": "HLA-CORE uses Event Sourcing because FR-011 (history reconstruction), FR-009 (temporally-bounded state queries), and FR-008 (Fact provenance/temporal validity) are all satisfied by folding an event log; the rejected alternative was a mutable CRUD store with a bolted-on audit log, rejected due to drift risk under NFR-003/NFR-006.",
      "evidence": [
        {
          "resource": "repo://docs/architecture/engine-hla.md#L176-L178",
          "version": "repo-lines-v1:sha256:89bd263db7090554800c115ebf2cac6e192e5574d9e639a034b5a74d0f66316e:"
        }
      ]
    },
    {
      "id": "claim_caed267266504e7f8cb7abd0518a7239",
      "statement": "HLA-CORE is internally decomposed into nine named units (CampaignObjectRegistry, EventAppender, RealityFoldEngine, FactIndex, RelationshipIndex, CampaignTimeIndex, HistoryReader, SnapshotOriginator, AssetReferenceRegistry) each with an explicit ownership boundary, to avoid becoming a God Component.",
      "evidence": [
        {
          "resource": "repo://docs/design/components/hla-core-dd.md#L151-L165",
          "version": "repo-lines-v1:sha256:198ae388d2b2726b25f6ceee5f9374727b46258f63d679a8f094b65b7de29c92:"
        }
      ]
    },
    {
      "id": "claim_7757f06fc5974b72bbdd18c91f05d946",
      "statement": "A Location is modeled as an Entity with spatial relationship capability; the engine does not hardcode a single spatial model, and spatial semantics are package-defined.",
