    {
      "id": "claim_b98873afff0d48b0b99be978b837db09",
      "statement": "HLA-PACKAGE combines Microkernel (subsystem level, since Packages are plugins against a fixed core contract) with Builder (composition-process level, for multi-step assembly of the Effective Campaign Definition); Prototype was rejected because there is no existing ECD to clone from scratch, and a plain conflict-resolution Strategy was rejected because FR-021 requires conflicts to fail loudly rather than silently pick a winner.",
      "evidence": [
        {
          "resource": "repo://docs/architecture/engine-hla.md#L209-L211",
          "version": "repo-lines-v1:sha256:8cfd8d94767d3f0b152c04e56a7f0d0e63ee77b01ff7d2de3048e3086146b4ff:"
        }
      ]
    },
    {
      "id": "claim_6ba588f8296443a492263ff2cd42059c",
      "statement": "HLA-PACKAGE is internally decomposed into nine units (PackageRegistry, DependencyResolver, CompositionBuilder, ConflictDetector, PinManager, MigrationPlanner, RemovalGuard, SemanticReferenceCatalog, PackageContractProvider) each with an explicit boundary.",
      "evidence": [
        {
          "resource": "repo://docs/design/components/hla-package-dd.md#L151-L161",
          "version": "repo-lines-v1:sha256:92ee5f14336014b02e88a71220760e69369559058d30fdb6c8ffb3e98940a4b9:"
        }
      ]
    },
    {
      "id": "claim_8d4baf458e36400fbd5e1bddc6f3ef1c",
      "statement": "Composition follows a fixed nine-step order ending in submission to HLA-VALIDATE; Extension (adds/specializes without replacing) and Override (deliberately replaces, must name its target) are distinct and HLA-PACKAGE never infers an override from name collision, load order, priority, or match order.",
      "evidence": [
        {
          "resource": "repo://docs/design/components/hla-package-dd.md#L238-L255",
          "version": "repo-lines-v1:sha256:0d8e4365189fb0c834f2ec76455c873bb34393d5f6bfad3af81bda7c974a5404:"
        }
      ]
    },
    {
      "id": "claim_bc6c2c0c458947c28e3278142528f183",
      "statement": "The Effective Campaign Definition never becomes Campaign Reality by itself, never mutates a running Campaign outside the lifecycle/migration flow, and never hides unresolved composition conflicts; a CompositionPin records the exact package set and composition context so new Package version registrations never silently affect an existing Campaign's pin.",
      "evidence": [
        {
          "resource": "repo://docs/design/components/hla-package-dd.md#L287-L301",
          "version": "repo-lines-v1:sha256:c40974e50ebec6a17b00bf06a56d8d1a13bbd626d7deaf1b93db8462f668c49e:"
